QMESH_COLDSTEAL_SMAX=8
QMESH_COLDSTEAL_MAX_ROWS=48
EXL3_DSV41_BATCH=1
EXL3_DRAFT_WIDE_JOBS=4
EXL3_DRAFT_WIDE_WINDOW=2
